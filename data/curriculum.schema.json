{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vfcc.example/schemas/curriculum.schema.json",
  "title": "VFCC M&A Theory Curriculum",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "description", "weeks", "sources"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "weeks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/week" }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "week": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "label", "title", "summary", "topics"],
      "properties": {
        "id": { "type": "string", "pattern": "^week-[236]$" },
        "number": { "type": "integer", "enum": [2, 3, 6] },
        "label": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/topic" }
        }
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "learningQuestions",
        "subtopics",
        "sourceIds"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^w[236]-[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 64 },
        "summary": { "type": "string", "minLength": 1 },
        "learningQuestions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "subtopics": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "citation", "type", "priority"],
      "properties": {
        "id": { "type": "string", "pattern": "^src-[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "citation": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["Paper", "Book", "Guide", "Website", "Professional standard"]
        },
        "priority": { "type": "string", "enum": ["Core", "Recommended"] },
        "url": { "type": "string", "format": "uri" },
        "verificationNote": { "type": "string", "minLength": 1 }
      }
    }
  }
}
